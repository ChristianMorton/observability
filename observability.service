[Unit]
Description=Observability Stack (OTel Collector, Loki, Jaeger, Prometheus, Grafana)
Documentation=file:///opt/observability/README.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/observability
ExecStart=/opt/observability/obs.sh up -d --remove-orphans
ExecStop=/opt/observability/obs.sh down
ExecReload=/opt/observability/obs.sh pull && /opt/observability/obs.sh up -d --remove-orphans
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
